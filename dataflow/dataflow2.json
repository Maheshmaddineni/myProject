{
	"name": "dataflow2",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DelimitedText7",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DelimitedText8",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "select1"
				},
				{
					"name": "filter1"
				},
				{
					"name": "splituk"
				}
			],
			"scriptLines": [
				"source(output(",
				"          InvoiceNo as integer,",
				"          StockCode as integer,",
				"          Description as string,",
				"          Quantity as integer,",
				"          InvoiceDate as date,",
				"          UnitPrice as double,",
				"          CustomerID as integer,",
				"          Country as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 select(mapColumn(",
				"          InvoiceNo,",
				"          Description,",
				"          InvoiceDate,",
				"          UnitPrice,",
				"          CustomerID,",
				"          Country",
				"     ),",
				"     partitionBy('hash', 1),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 filter(InvoiceNo==537678) ~> filter1",
				"filter1 split(Country=='United Kingdom',",
				"     Country=='Germany',",
				"     disjoint: false,",
				"     partitionBy('hash', 1)) ~> splituk@(Unitedkingdom, Germany, others)",
				"splituk@Unitedkingdom sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink1"
			]
		}
	}
}